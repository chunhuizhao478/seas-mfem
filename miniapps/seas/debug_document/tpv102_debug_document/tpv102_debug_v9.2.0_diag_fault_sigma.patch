 // Mult: dQ/dt = M^{-1} * (-Face + Vol)   [Eq. (3)]
 // ---------------------------------------------------------------------------
 template <typename MeshType>
 void WaveOperator<MeshType>::Mult(const Vector &Q, Vector &dQdt) const
 {
    MFEM_VERIFY(Q.Size() == height,
                "Q size mismatch: " << Q.Size() << " vs " << height);

    dQdt.SetSize(height);
    dQdt = 0.0;

+#ifdef SEAS_DIAG_FAULT_SIGMA
+   // v9.2.0 §5.1 diagnostic accumulators (reset per Mult call).
+   // Populated inside ComputeFaceFluxRHS / ComputeSharedFaceFluxRHS
+   // via the thread-local pointer diag_syy_ptr_ below.  `mutable`
+   // members because Mult is a `const` method; these are diagnostic-
+   // only state.  No effect on dQdt.
+   diag_max_syy_ = 0.0;
+   diag_max_vy_  = 0.0;
+   diag_max_syz_ = 0.0;
+   diag_max_vz_  = 0.0;
+#endif
+
    ComputeVolumeRHS(Q, dQdt);
    ComputeFaceFluxRHS(Q, dQdt);

    // Shared face flux for parallel (R-002 fix)
    if constexpr (IsParallelMesh<MeshType>::value)
    {
       ComputeSharedFaceFluxRHS(Q, dQdt);
    }

    if (pml_layer_)
    {
       ApplyPMLDamping(Q, dQdt);
    }

    ApplyMassInverse(dQdt);
+
+#ifdef SEAS_DIAG_FAULT_SIGMA
+   // MPI-reduce over ranks and print.
+   real_t sums[4] = { diag_max_syy_, diag_max_vy_, diag_max_syz_, diag_max_vz_ };
+   real_t globals[4] = {0,0,0,0};
+   if constexpr (IsParallelMesh<MeshType>::value)
+   {
+#ifdef MFEM_USE_MPI
+      MPI_Allreduce(sums, globals, 4, MPITypeMap<real_t>::mpi_type, MPI_MAX,
+                    static_cast<const ParMesh &>(mesh_).GetComm());
+#else
+      for (int i = 0; i < 4; i++) globals[i] = sums[i];
+#endif
+   } else {
+      for (int i = 0; i < 4; i++) globals[i] = sums[i];
+   }
+   int rank_pr = 0;
+#ifdef MFEM_USE_MPI
+   if constexpr (IsParallelMesh<MeshType>::value)
+   { rank_pr = static_cast<const ParMesh &>(mesh_).GetMyRank(); }
+#endif
+   if (rank_pr == 0)
+   {
+      std::fprintf(stderr,
+         "[FAULT-DIAG-SYY] max|SYY|=%.6e max|VY|=%.6e max|SYZ|=%.6e max|VZ|=%.6e\n",
+         globals[0], globals[1], globals[2], globals[3]);
+   }
+#endif
 }

