# Simulation results (large output files)
bp2/results_*/
bp2_full_*.txt
bp1/results_*/
bp1_full_*.txt
# SAFS spatial-dynamic run outputs (multi-GB ParaView/checkpoint dirs)
output_safs_dyn_*/
safs/safs_dyn_*/
# SAFS mesh-refinement experiment: large STL source + compiled CGAL remesher
# and its CMake build artifacts (regenerable from remesh_fault_cgal.cpp +
# CMakeLists.txt; the .msh is already ignored via *.msh above).
safs/project_7.0_alternative/experimental_mesh_refinement/*.stl
safs/project_7.0_alternative/experimental_mesh_refinement/remesh_cgal/build/
# Pre-split per-rank mesh files (seas_partition_mesh output: <prefix>.NNNNNN +
# <prefix>.np).  Large (sum ~= the .msh) and rank-count-specific — regenerate
# on the cluster via spatial_dyn_partition_250m_safs.sbatch.
safs/project_7.0_alternative/experimental_mesh_refinement/presplit/
# Large reference papers (multi-MB PDFs) — keep out of git history.
safs/project_7.0_alternative/friction/rate-and-state/*.pdf

