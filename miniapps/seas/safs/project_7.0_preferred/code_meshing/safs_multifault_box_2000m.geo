// =============================================================
// safs_multifault_box_2000m.geo  (generated; do not edit by hand)
//
// Embed the 6 corefined SAFS faults inside a 3-D bounding box.
// Fault sources: ../data_corefined/*_2000m_corefined.stl, produced by
// code_preprocess/corefine_faults.py (CGAL corefine + cleanup;
// see document/PLAN_cgal_corefine_multifault.md).
//
// Generator: code_preprocess/generate_multifault_geo.py
// Manifest:  ../data_corefined/manifest.json
//
// Generate mesh:
//   gmsh -3 safs_multifault_box_2000m.geo -o safs_multifault_box_2000m.msh
//
// All units: meters.  Coordinates: UTM.
// =============================================================
SetFactory("OpenCASCADE");

// 1. Domain bounds: union of corefined-fault bboxes + paddings.
//    Filled in from manifest by the generator.
xmin_fault = 365072.30;  xmax_fault = 622329.50;
ymin_fault = 3692278.00;  ymax_fault = 3838985.00;
zmin_fault = -18073.44;  zmax_fault = 0.00;   // top trace clipped at z=0

PAD_XY     = 50000.0;   // 50 km horizontal margin
PAD_TOP    = 100.0;   // 100 m of rock above the free surface
PAD_BOTTOM = 25000.0;   // 25 km of rock below deepest fault vertex

xmin = xmin_fault - PAD_XY;
xmax = xmax_fault + PAD_XY;
ymin = ymin_fault - PAD_XY;
ymax = ymax_fault + PAD_XY;
zmin = zmin_fault - PAD_BOTTOM;
zmax = zmax_fault + PAD_TOP;
dx = xmax - xmin;  dy = ymax - ymin;  dz = zmax - zmin;

// 2. Mesh size controls.  HARD floor: LC_MIN must equal Phase 1 --min-edge.
//    LC_MIN, LC_NEAR, LC_FAR sourced from manifest:
//      LC_MIN  = manifest.min_edge       (= --min-edge passed to corefine)
//      LC_NEAR = manifest.mesh_edge_size (= --mesh-edge-size passed to corefine)
//      LC_FAR  = --lc-far  (default 10 * LC_NEAR)
LC_MIN     = 100.00;
LC_NEAR    = 1500.00;
LC_FAR     = 15000.00;
DIST_INNER = 3000.00;
DIST_OUTER = 40000.00;

Mesh.MeshSizeMin                = LC_MIN;
Mesh.MeshSizeMax                = LC_FAR;
Mesh.MeshSizeExtendFromBoundary = 0;
Mesh.MeshSizeFromPoints         = 0;
Mesh.MeshSizeFromCurvature      = 0;
Geometry.Tolerance              = 0.001;          // 1 mm; tighter than STL writer LSB at UTM scale

// Disable gmsh's facet-overlap detector.  Default 0.1° flags any pair of
// non-manifold incident triangles whose dihedral angle is below threshold.
// Our combined STL has 54+ polyline edges with dihedral < 0.1° (fault pairs
// meeting at near-coplanar angles — geological reality at the SBMT-MC × SBMT-
// SAF intersection, etc.).  Setting to 0 lets the 3-D mesher proceed; the
// resulting tets near these edges are necessarily thin (sliver-like) but
// Mesh.OptimizeNetgen below should clean them up.
Mesh.AngleToleranceFacetOverlap = 0;

// 3. Box volume.  OCC tags 1..6 for box faces; volume tag 1.
Box(1) = {xmin, ymin, zmin, dx, dy, dz};

// 4. Merge ONE combined STL containing the box (12 tris) + all 6
//    fault triangulations as a single non-manifold discrete surface.
//    Built by code_preprocess/stitch_combined_stl.py from data_corefined/.
//    The single-Merge approach (vs per-fault Merges) is required because
//    tetgen rejects multi-surface PLCs at shared polyline edges; with one
//    discrete surface containing those edges as INTERNAL non-manifold
//    edges, tetgen handles them via its standard non-manifold logic.
Merge "../data_corefined/safs_combined_2000m.stl";

// gmsh assigns the merged STL discrete-surface tag 7.  Embed it.
combined_surf = 7;
Surface{combined_surf} In Volume{1};

// 5. Distance-based size field on the polyline POINTS (PLAN_revert_to_gmsh.md
//    §Phase 2 Plan B; original gmsh-plan §Variant 3.5a').  Auxiliary Point()
//    entities are emitted at every corefined fault-fault polyline vertex; the
//    Distance field measures distance to the nearest such point, then a
//    Threshold ramps SizeMin=LC_NEAR at d=DIST_INNER to SizeMax=LC_FAR at
//    d=DIST_OUTER.  Geometry.Tolerance = 1e-3 m guarantees these Points
//    dedup against the discrete-STL polyline vertices (which are at %.15g
//    precision in the input STL).
POLY_PT_ID_START   = 100000;
POLY_LINE_ID_START = 200000;
// Polyline vertices and lines:
