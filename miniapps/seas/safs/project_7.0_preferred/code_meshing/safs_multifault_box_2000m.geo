poly_curve_ids[] = {200000, 200001, 200002, 200003, 200004, 200005, 200006, 200007, 200008, 200009, 200010, 200011, 200012, 200013, 200014, 200015, 200016, 200017, 200018, 200019, 200020, 200021, 200022, 200023, 200024, 200025, 200026, 200027, 200028, 200029, 200030, 200031, 200032, 200033, 200034, 200035, 200036, 200037, 200038, 200039, 200040, 200041, 200042, 200043, 200044, 200045, 200046, 200047, 200048, 200049, 200050, 200051, 200052, 200053, 200054, 200055, 200056, 200057, 200058, 200059, 200060, 200061, 200062, 200063, 200064, 200065, 200066, 200067, 200068, 200069, 200070, 200071, 200072, 200073, 200074, 200075, 200076, 200077, 200078, 200079, 200080, 200081, 200082, 200083, 200084, 200085, 200086, 200087, 200088, 200089, 200090, 200091, 200092, 200093, 200094, 200095, 200096, 200097, 200098, 200099, 200100, 200101, 200102, 200103, 200104, 200105, 200106, 200107, 200108, 200109};

// Distance field: distance to the nearest polyline vertex (PointsList).
// Plan §Variant 3.5a' fallback; bypasses ambiguity of Distance over the
// merged STL surface (which would otherwise pick up the box faces too).
Field[1] = Distance;
Field[1].PointsList = {poly_pt_ids[]};
Field[1].Sampling   = 50;

Field[2] = Threshold;
Field[2].InField  = 1;
Field[2].SizeMin  = LC_NEAR;
Field[2].SizeMax  = LC_FAR;
Field[2].DistMin  = DIST_INNER;
Field[2].DistMax  = DIST_OUTER;
Background Field = 2;

// 6. Physical groups.  All 6 faults share a single 'fault_all' tag (100);
//    downstream Python (msh_to_vtu.py) splits per-fault using the
//    safs_combined_<R>m_provenance.json file.
//    Box boundaries: top=200, bottom=201, sides=202.
Physical Volume("rock", 1)         = {1};
Physical Surface("fault_all", 100) = {combined_surf};
Physical Surface("top",      200) = {6};
Physical Surface("bottom",   201) = {5};
Physical Surface("sides",    202) = {1, 2, 3, 4};

// 7. Mesh algorithms (proven on single-fault freesurface_clip variant).
Mesh.Algorithm   = 6;     // 2-D: Frontal-Delaunay
Mesh.Algorithm3D = 1;     // 3-D: Delaunay (HXT/Algorithm3D=10 fails on
                          // embedded discrete STLs)

// 8. Phase 3.5b: post-mesh tet optimization (mandatory per original plan).
//    Mesh.OptimizeNetgen typically raises min q_tet from ~0.05 to ~0.15.
Mesh.Optimize          = 1;
Mesh.OptimizeNetgen    = 1;
Mesh.OptimizeThreshold = 0.3;
Mesh.HighOrderOptimize = 0;
