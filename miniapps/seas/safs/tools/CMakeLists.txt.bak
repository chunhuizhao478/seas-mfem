# SAFS tools — CGAL-based corefinement of multi-fault meshes.
#
# This CMakeLists is the single build entry point for the SAFS C++
# tools (PLAN_cgal_corefine.md Phase 0).  It is NOT auto-built by
# the existing MFEM Makefile; build manually from this directory:
#
#     conda activate mfem-dev
#     cmake -S miniapps/seas/safs/tools -B miniapps/seas/safs/tools/build \
#           -DCMAKE_BUILD_TYPE=Release
#     cmake --build miniapps/seas/safs/tools/build
#
# Phase 0 lands the empty-shell `corefine_faults_hello` target
# (verifies the build environment); Phase 1+ extends this file with
# the real `corefine_faults` target.

cmake_minimum_required(VERSION 3.18)
project(safs_tools CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release CACHE STRING
        "Build type (Release / Debug / RelWithDebInfo)" FORCE)
endif()

# CGAL version policy:
#   - 5.6.x: original tested baseline (uses cascade corefine path
#     in tools/corefine_faults/corefine.cpp).
#   - 6.1+:  required for `PMP::autorefine_triangle_soup()` with
#     `apply_iterative_snap_rounding(true)`, which eliminates the
#     sub-meter intersection-curve splits that drive bulk slivers.
#     See PLAN_cgal_corefine.md §Phase 5 sliver-tune addendum.
#
# The 6.0 branch is skipped: it added the public function but
# without the snap-rounding parameter we rely on; 6.1.1 is the
# minimum useful version for autorefine_triangle_soup mode.
find_package(CGAL 5.4 REQUIRED COMPONENTS Core)
if(CGAL_VERSION VERSION_LESS 6.1)
    message(STATUS "Using legacy CGAL ${CGAL_VERSION} build path; "
                   "autorefine_triangle_soup snap-rounding "
                   "requires CGAL 6.1+ (set up the cgal-61 conda env).")
    set(SAFS_HAVE_AUTOREFINE_SNAP FALSE)
else()
    set(SAFS_HAVE_AUTOREFINE_SNAP TRUE)
endif()

find_package(Boost 1.66 REQUIRED)

# In-tree CGAL header shim.  Workaround for the conda-forge cgal-cpp
# 5.6.1 package's `Halfedge_around_target_iterator::operator bool()`
# bug under Apple Clang — the iterator class does not inherit from
# anything providing `base()`, but `operator bool()` calls
# `this->base()`.  The shim replaces those bodies with the
# semantically-equivalent `this->g != nullptr`.  See
# `cgal_patch/README.md` for details and removal conditions.
#
# CGAL 6.1+ replaced `this->base()` with `this->base_reference()`
# upstream — the shim is unnecessary on those headers, so we only
# enable it for legacy 5.x builds.
set(SAFS_TOOLS_CGAL_PATCH_DIR "${CMAKE_CURRENT_SOURCE_DIR}/cgal_patch")
if(CGAL_VERSION VERSION_LESS 6.0)
    if(NOT EXISTS "${SAFS_TOOLS_CGAL_PATCH_DIR}/CGAL/boost/graph/iterator.h")
        message(FATAL_ERROR
            "Missing CGAL header shim at ${SAFS_TOOLS_CGAL_PATCH_DIR} "
            "(required for legacy CGAL ${CGAL_VERSION}).  "
            "See tools/cgal_patch/README.md.")
    endif()
    set(SAFS_TOOLS_CGAL_PATCH_INCLUDE "${SAFS_TOOLS_CGAL_PATCH_DIR}")
else()
    set(SAFS_TOOLS_CGAL_PATCH_INCLUDE "")
endif()

# Phase-0 hello-world target — confirms the environment links
# against CGAL + Boost + GMP + MPFR and can compile the corefinement
# headers.  Kept around in Phase 1 as a build-environment smoke
# check; the production binary is `corefine_faults` below.
add_executable(corefine_faults_hello main.cpp)
target_include_directories(corefine_faults_hello BEFORE PRIVATE
    ${SAFS_TOOLS_CGAL_PATCH_DIR})
target_link_libraries(corefine_faults_hello PRIVATE CGAL::CGAL)

# `<filesystem>` link guard for old toolchains: pre-9.0 gcc puts
# `<filesystem>` symbols in a separate library `stdc++fs`.  Frontera's
# gcc 9.1 already includes them in libstdc++; the guard is therefore
# a no-op on every toolchain we currently target, but kept here for
# safety in case an older module is ever loaded.
if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU"
   AND CMAKE_CXX_COMPILER_VERSION VERSION_LESS 9.0)
    target_link_libraries(corefine_faults_hello PRIVATE stdc++fs)
endif()

target_compile_options(corefine_faults_hello PRIVATE
    $<$<CONFIG:Release>:-O2>
)

# ----------------------------------------------------------------------
# Phase 1 — `corefine_faults` production binary
# ----------------------------------------------------------------------
# Wraps PMP::corefine for one unordered fault pair, orchestrates over
# all pairs with a shared edge_is_constrained_map per fault (P-002),
# and emits per-fault conformal STLs + diagnostic JSON sidecars.

add_executable(corefine_faults
    corefine_faults/main.cpp
    corefine_faults/io.cpp
    corefine_faults/corefine.cpp
    corefine_faults/autorefine_mode.cpp
)
target_include_directories(corefine_faults BEFORE PRIVATE
    ${SAFS_TOOLS_CGAL_PATCH_DIR})
target_include_directories(corefine_faults PRIVATE
    ${CMAKE_CURRENT_SOURCE_DIR})
target_link_libraries(corefine_faults PRIVATE CGAL::CGAL)
target_compile_options(corefine_faults PRIVATE
    $<$<CONFIG:Release>:-O2>
)
if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU"
   AND CMAKE_CXX_COMPILER_VERSION VERSION_LESS 9.0)
    target_link_libraries(corefine_faults PRIVATE stdc++fs)
endif()

# ----------------------------------------------------------------------
# Phase 1 — hand-rolled C++ smoke test (no GoogleTest dep)
# ----------------------------------------------------------------------
enable_testing()

add_executable(test_corefine_smoke
    tests/test_corefine_smoke.cpp
    corefine_faults/corefine.cpp
    corefine_faults/io.cpp
)
target_include_directories(test_corefine_smoke BEFORE PRIVATE
    ${SAFS_TOOLS_CGAL_PATCH_DIR})
target_include_directories(test_corefine_smoke PRIVATE
    ${CMAKE_CURRENT_SOURCE_DIR})
target_link_libraries(test_corefine_smoke PRIVATE CGAL::CGAL)
target_compile_options(test_corefine_smoke PRIVATE
    $<$<CONFIG:Release>:-O2>
)
if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU"
   AND CMAKE_CXX_COMPILER_VERSION VERSION_LESS 9.0)
    target_link_libraries(test_corefine_smoke PRIVATE stdc++fs)
endif()

add_test(NAME corefine_smoke COMMAND test_corefine_smoke)

message(STATUS "SAFS tools — CGAL ${CGAL_VERSION}, "
               "Boost ${Boost_VERSION}, "
               "C++${CMAKE_CXX_STANDARD}")
