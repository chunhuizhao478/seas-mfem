! =====================================================================
! SCEC TPV104, rate and state, slip law with strong velocity weakening --
! SeisSol leg of the Vista speed test against the MFEM Nitsche driver on
! the SAME Gmsh mesh (tpv104/mesh/tpv104_200m.geo; tags 1 free, 3 fault,
! 5 absorbing = SeisSol's default face map, FaceMap.cpp:98-117).
!
! Physics source of truth: miniapps/seas/tpv104/configs/tpv104_nitsche.toml.
! Started from the July IO-on deck jobs/lts_phase5/tpv104_200m_seissol_expanse/
! (FL 103, RS constants, t_0 = 1.0 = MFEM T_nuc_s); the boxcar / bell are
! rewritten in the MFEM form (branches instead of tanh at the poles) and the
! nucleation radius is measured in the fault plane as MFEM does.  Checked by
!   python3 ../../check_parity.py --problem tpv104 --repo <repo root>
! Keys verified against SeisSol a8e7f04f (file:line in ../../NOTES.md).
!
! ORDER is compile-time in SeisSol: this one body serves every order.
! NOT matched (NOTES.md "Open"): Kelvin-Voigt kv_eta = 0.1 and
! Prakash-Clifton v* = 1, L = 0.01 (MFEM only).
! =====================================================================

&equations
MaterialFileName = 'tpv104_material.yaml'
Plasticity = 0
numflux = 'godunov'
/

&IniCondition
/

&DynamicRupture
FL = 103                         ! RS, slip law + strong velocity weakening (Misc.h:41)
ModelFileName = 'tpv104_fault.yaml'
RS_f0  = 0.6                     ! toml f_0_default
RS_sr0 = 1.0e-6                  ! toml V_0_default
RS_b   = 0.014                   ! toml b_default
RS_muW = 0.2                     ! toml f_w_default
RS_iniSlipRate1 = 1.0e-16        ! toml V_init_default (magnitude; sets psi_0)
RS_iniSlipRate2 = 0.0
t_0 = 1.0                        ! smoothStep time of nuc_* = toml T_nuc_s
XRef = 0.0                       ! reference point on the y<0 (MFEM plus) side
YRef = -1.0e5
ZRef = 0.0
refPointMethod = 0
SlipRateOutputType = 1
OutputPointType = 3              ! on-fault pickpoints only, no elementwise
/

&Elementwise
/

&Pickpoint
PPFileName = 'tpv104_faultreceivers.dat'
printtimeinterval = 1            ! every fault time step
!            SR  Ttr un MuSt Ttot Slip Vr ASl PSR RT DS TP   (DataTypes.h:113-127)
OutputMask = 1   0   0  1    1    1    0  1   0   0  0  0
/

&SourceType
/

&SpongeLayer
/

&MeshNml
MeshFile = 'tpv104_200m.puml.h5'
meshgenerator = 'PUML'
/

&Discretization
CFL = 0.5
ClusteredLTS = 2
/

&Output
OutputFile = 'output/tpv104'
Format = 10
WaveFieldOutput = 0
iOutputMask = 0 0 0 0 0 0 1 1 1
SurfaceOutput = 0
EnergyOutput = 0
EnergyTerminalOutput = 0
ReceiverOutput = 1               ! off-fault receivers: MFEM DefaultSurfaceStations_TPV104
pickdt = 0.005                   ! (tpv104_setup.hpp:209-219), z = 0
RFileName = 'tpv104_receivers.dat'
Checkpoint = 0
/

&AbortCriteria
EndTime = 12.0
/

&Analysis
/

&Debugging
/
