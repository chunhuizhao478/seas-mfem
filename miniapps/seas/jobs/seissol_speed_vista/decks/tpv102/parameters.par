! =====================================================================
! SCEC TPV102, rate and state, aging law -- SeisSol leg of the Vista speed
! test against the MFEM Nitsche driver on the SAME Gmsh mesh.  As the task
! sets it, TPV102 runs on the TPV104 200 m mesh (tpv104/mesh/tpv104_200m.geo:
! the same geometry, sizes and tags as tpv102/mesh/tpv102_200m.geo, the .geo
! files differ in comments only); tags 1 free, 3 fault, 5 absorbing = SeisSol's
! default face map (FaceMap.cpp:98-117).
!
! Physics source of truth: the deck of the TPV102 Nitsche gold
! (tpv102/gold/nitsche-kv0p1_p2_cd_pc_200m_jobid7995488_git2e0c04a/jobs/,
! physics identical to miniapps/seas/tpv102/configs/tpv102_nitsche_pc_p2_kv0p1.toml;
! there is no p = 3 gold).  Checked by
!   python3 ../../check_parity.py --problem tpv102 --repo <repo root>
! Keys verified against SeisSol a8e7f04f (file:line in ../../NOTES.md).
!
! ORDER is compile-time in SeisSol: this one body serves every order.
! NOT matched (NOTES.md "Open"): Kelvin-Voigt kv_eta = 0.1 and
! Prakash-Clifton v* = 1, L = 0.01 (MFEM only).
! =====================================================================

&equations
MaterialFileName = 'tpv102_material.yaml'
Plasticity = 0
numflux = 'godunov'
/

&IniCondition
/

&DynamicRupture
FL = 3                           ! RS, aging law (Misc.h:39)
ModelFileName = 'tpv102_fault.yaml'
RS_f0  = 0.6                     ! toml f_0_default
RS_sr0 = 1.0e-6                  ! toml V_0_default
RS_b   = 0.012                   ! toml b_default
RS_iniSlipRate1 = 1.0e-12        ! toml V_init_default (magnitude; sets theta_0)
RS_iniSlipRate2 = 0.0
t_0 = 1.0                        ! smoothStep time of nuc_* = toml T_nuc_s
XRef = 0.0                       ! reference point on the y<0 (MFEM plus) side
YRef = -1.0e5
ZRef = 0.0
refPointMethod = 0
SlipRateOutputType = 1
OutputPointType = 3              ! on-fault pickpoints only, no elementwise
/

&Elementwise
/

&Pickpoint
PPFileName = 'tpv102_faultreceivers.dat'
printtimeinterval = 1            ! every fault time step
!            SR  Ttr un MuSt Ttot Slip Vr ASl PSR RT DS TP   (DataTypes.h:113-127)
OutputMask = 1   0   0  1    1    1    0  1   0   0  0  0
/

&SourceType
/

&SpongeLayer
/

&MeshNml
MeshFile = 'tpv104_200m.puml.h5'
meshgenerator = 'PUML'
/

&Discretization
CFL = 0.5
ClusteredLTS = 2
/

&Output
OutputFile = 'output/tpv102'
Format = 10
WaveFieldOutput = 0
iOutputMask = 0 0 0 0 0 0 1 1 1
SurfaceOutput = 0
EnergyOutput = 0
EnergyTerminalOutput = 0
ReceiverOutput = 1               ! off-fault receivers: MFEM DefaultSurfaceStations
pickdt = 0.005                   ! (tpv102_setup.hpp:178-189), z = 0
RFileName = 'tpv102_receivers.dat'
Checkpoint = 0
/

&AbortCriteria
EndTime = 12.0
/

&Analysis
/

&Debugging
/
