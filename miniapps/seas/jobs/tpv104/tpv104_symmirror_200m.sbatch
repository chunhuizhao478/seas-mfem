#!/bin/bash
#SBATCH -J tpv104_symmir
#SBATCH -o tpv104_symmir_%j.out
#SBATCH -e tpv104_symmir_%j.err
#SBATCH -p development
#SBATCH -N 8
#SBATCH -n 400
#SBATCH -t 02:00:00
#SBATCH -A EAR20006

# TPV104 σ_n leak discriminator — Y-mirror-symmetric mesh @ 200 m, t = 2 s
# ========================================================================
#
# Purpose
# -------
# The local 2-step test on tpv104_symmirror_1000m.msh proved that the
# bulk wave operator + fault Riemann produce bit-exact mirror-symmetric
# Q on the symmetric channels and bit-exact anti-symmetric on the
# strike-slip velocity channel — when the tet topology is mirror-
# symmetric.  The 0.46 MPa σ_yy asymmetry observed in the TPV104
# production runs (jobs 7677547, 7677719, 7677759) on tpv104_200m.msh
# came from the mesh, not the code.
#
# This sbatch runs the same TPV104 setup on a Y-mirror-symmetric mesh
# and produces direct comparison data with the existing fwfix /
# bulk-asym runs at 200 m / t=2 s / 400 ranks.
#
# Expected outcome
# ----------------
# σ_n perturbation at the hypocenter station drops from ±0.5 MPa
# (asymmetric mesh) to ~ULP (symmetric mesh, modulo any FP non-
# associativity in the bulk operator).  V_strike at the hypocenter
# should remain close to SeisSol reference (7.39 m/s peak, similar
# to fwfix's 7.42 m/s).
#
# Mesh
# ----
# tpv104_symmirror_200m.msh: 137,781 nodes, 768,000 tets, uniform 200 m
# resolution, domain [-8, 8] km × [-2, 2] km × [-16, 0] km (smaller
# than the 60 km SCEC box but covers the hypocenter and full rupture
# front for t ≤ 2 s without boundary contamination — see calc below).
#
# Generated by tpv104/mesh/build_symmirror_mesh.py — Python script
# (not Gmsh .geo) because Gmsh's tet mesher is not deterministic on
# mirror-symmetric input geometry.  The script constructs the tet
# topology directly with a y-bit-swapped 6-tet pattern on the −Y half.
#
# Domain-vs-tfinal sanity (cs = 3464 m/s, cp = 6000 m/s):
#   - Y absorbing boundary at ±2 km: P-wave roundtrip 4 km / cp = 0.67 s
#     (within the 2 s window — relies on absorbing BCs).
#   - X absorbing boundary at ±8 km: roundtrip 16 km / cs = 4.6 s
#     (no contamination at t < 4.6 s).
#   - Bottom at z = −16 km: from hypo (z=−7.5) roundtrip 17 km / cs
#     = 4.9 s (no contamination at t < 4.9 s).
# The Y-direction relies on absorbing BC fidelity.  If σ_n drift at
# late time (t > 1.5 s) doesn't drop on this mesh, that's a clue the
# Y-BC reflection — not the per-step bulk asymmetry — is dominant.
#
# Mesh / dispatch parity with fwfix run
# -------------------------------------
#   - dx = 200 m (matches lc_fault in tpv104_200m.geo).
#   - 8 nodes × 400 ranks (same as fwfix; ~1900 tets/rank).
#   - --ader-order 2, --order 1, --cfl 0.5 (same).
#   - --tfinal 2.0, --bc-mode absorbing (same).
#   - --friction-solver / --fault-iterator / --fric-law: same banner
#     values (production path is Brent + one-shot ADER + macro-step ψ
#     per R7-001(b) regardless).
#
# Probe configuration
# -------------------
# This run uses the PRODUCTION binary (no SEAS_DIAG_FAULT_FLUX).  The
# σ_n comparison is via the station-output files (sigma_n_corr column
# in the per-station .dat) which are always written.  For a follow-up
# diag-on run with C-1n / C-1s / C-2A/B/C probes for per-DOF
# verification, see tpv104_symmirror_diag.sbatch (TODO if needed).
#
# Pre-requisites
# --------------
#   1. tpv104/mesh/tpv104_symmirror_200m.msh exists.  Generate locally:
#        cd miniapps/seas/tpv104/mesh
#        python3 build_symmirror_mesh.py --dx 200 --lx 16000 --ly 4000 \
#                --lz 16000 --out tpv104_symmirror_200m.msh
#      and scp to Frontera, OR run the script on Frontera (no Gmsh needed).
#   2. f_w = 0.2 (post-fix) in config/tpv104_params.hpp.

export LC_ALL=C
export LANG=C

SBATCH_LOG_DIR="${SLURM_SUBMIT_DIR:-$PWD}"

module load intel/19.1.1
module load impi/19.0.9
module load hypre/2.31.0
module load mumps/5.3
module load parmetis
module load petsc/3.15
module load fftw3/3.3.8

export LD_LIBRARY_PATH="${TACC_HYPRE_LIB}:${TACC_PARMETIS_LIB}:${TACC_MUMPS_LIB}:${TACC_PETSC_LIB}:${TACC_FFTW3_LIB}:${LD_LIBRARY_PATH}"

cd /scratch2/10024/zhaochun/seas-project/seas-mfem

JOBS=8

grep -q '^MFEM_USE_PETSC *= YES' config/config.mk || { echo "ERROR: no PETSc"; exit 1; }
grep -q '^MFEM_USE_MUMPS *= YES' config/config.mk || { echo "ERROR: no MUMPS"; exit 1; }

cd miniapps/seas

# Verify f_w fix is in place.
F_W_LINE=$(grep -E '^\s*static\s+constexpr\s+real_t\s+f_w' config/tpv104_params.hpp | head -1)
if ! echo "${F_W_LINE}" | grep -q '0\.2'; then
   echo "ERROR: config/tpv104_params.hpp f_w is NOT 0.2 — pull latest source."
   exit 1
fi
echo "f_w confirmed: ${F_W_LINE}"

# Build the symmetric mesh on Frontera (no Gmsh needed — pure Python).
if [ ! -s tpv104/mesh/tpv104_symmirror_200m.msh ]; then
   echo "Building symmetric 200 m mesh ..."
   cd tpv104/mesh
   python3 build_symmirror_mesh.py --dx 200 --lx 16000 --ly 4000 \
                                    --lz 16000 \
                                    --out tpv104_symmirror_200m.msh
   cd ../..
fi
if [ ! -s tpv104/mesh/tpv104_symmirror_200m.msh ]; then
   echo "ERROR: tpv104_symmirror_200m.msh missing after build attempt"
   exit 1
fi
echo "Mesh: $(ls -lh tpv104/mesh/tpv104_symmirror_200m.msh)"

PREV_INIT_RESULT=$(ls -dt tpv104/results_init_stations_job* 2>/dev/null | head -1)
if [ -z "${PREV_INIT_RESULT}" ] \
   || ! grep -q "^STATUS: PASS" "${PREV_INIT_RESULT}/RESULT.txt" 2>/dev/null; then
   echo "WARN: no passing tpv104_init_stations.sbatch result found.  Continuing anyway"
   echo "      (init test is on tpv104_200m.msh, not symmirror; ψ_ini gate is"
   echo "       parameter-controlled and won't differ on the symmetric mesh)."
fi

RESULT_DIR="tpv104/results_symmirror_job${SLURM_JOB_ID}"
mkdir -p "${RESULT_DIR}"

# Production build (no diag flag).  Forces a clean rebuild.
rm -f seas_tpv104_driver drivers/tpv104_driver.o \
      dynamic/tpv104_substep_iterator.o dynamic/friction_solver.o \
      dynamic/fault_face_flux.o dynamic/wave_operator.o
make seas_tpv104_driver -j"${JOBS}" || { echo "BUILD FAILED"; exit 1; }

unset SEAS_TPV104_FREEZE_SIGMA_N

echo "========================================"
echo "Git commit:   $(git rev-parse HEAD)"
echo "Git branch:   $(git rev-parse --abbrev-ref HEAD)"
echo "Output dir:   ${RESULT_DIR}"
echo "Mesh:         tpv104_symmirror_200m.msh (768k tets, Y-mirror-symmetric)"
echo "Target:       tfinal = 2.0 s at 8N×400r"
echo "Goal:         show σ_n at hypocenter drops from ±0.5 MPa to ~ULP"
echo "========================================"

ibrun ./seas_tpv104_driver \
      --mesh tpv104/mesh/tpv104_symmirror_200m.msh \
      --mesh-scale 1 \
      --order 1 \
      --bc-mode absorbing \
      --cfl 0.5 \
      --tfinal 2.0 \
      --ader-order 2 \
      --friction-solver newton-stable \
      --fric-law slip-srw \
      --fault-iterator substep \
      --output-dir "${RESULT_DIR}" \
      --output-prefix tpv104_symmir \
      --output-dt 0.05 \
      --paraview \
      --paraview-dt 0.25 \
      --paraview-bulk-dt 0.5 \
      --verify-dispatch

# Post-run analysis: compare σ_n at hypocenter vs fwfix baseline.
RESULT_FILE="${RESULT_DIR}/RESULT.txt"
HYPO_FILE="${RESULT_DIR}/tpv104_symmir_station_x2_0_x3_7.5.dat"

PEAK_V_HYPO="N/A"
PEAK_T_HYPO="N/A"
if [ -s "${HYPO_FILE}" ]; then
   read PEAK_V_HYPO PEAK_T_HYPO < <(awk '!/^#/ && NF>=3 {
      v=$3; if (v<0) v=-v;
      if (v>m) { m=v; tm=$1 }
   } END { printf "%g %g\n", m, tm }' "${HYPO_FILE}")
fi

# σ_n perturbation: column 8 = sigma_n_corr.  Compute peak |σ_n - 120 MPa|.
SIGMA_N_PERTURB_HYPO="N/A"
if [ -s "${HYPO_FILE}" ]; then
   SIGMA_N_PERTURB_HYPO=$(awk '!/^#/ && NF>=8 && $1+0==$1 {
      d=$8 - 120e6; if (d<0) d=-d;
      if (d>m) m=d
   } END { printf "%.4e", m+0 }' "${HYPO_FILE}")
fi

# Off-hypocenter station summary (matches fwfix sbatch acceptance table).
declare -A SEISSOL_PEAKS=(
   ["x2_0_x3_7.5"]="7.39"
   ["x2_-12_x3_3"]="9.93"   ["x2_12_x3_3"]="9.52"
   ["x2_-12_x3_12"]="8.37"  ["x2_12_x3_12"]="8.28"
   ["x2_-9_x3_7.5"]="6.29"  ["x2_9_x3_7.5"]="6.33"
   ["x2_0_x3_3"]="5.14"     ["x2_0_x3_12"]="11.40"
)
OFF_HYPO_TABLE=""
for tag in x2_0_x3_7.5 x2_0_x3_3 x2_0_x3_12 \
           x2_-9_x3_7.5 x2_9_x3_7.5 \
           x2_-12_x3_3 x2_12_x3_3 \
           x2_-12_x3_12 x2_12_x3_12; do
   SF="${RESULT_DIR}/tpv104_symmir_station_${tag}.dat"
   if [ -s "${SF}" ]; then
      MV=$(awk '!/^#/ && NF>=3 && $1+0==$1 {v=$3;if(v<0)v=-v;if(v>m)m=v} END{print m+0}' "${SF}")
      SV="${SEISSOL_PEAKS[$tag]}"
      RAT=$(awk "BEGIN{printf \"%.2f\", $MV/$SV}")
      SP=$(awk '!/^#/ && NF>=8 && $1+0==$1 {d=$8-120e6;if(d<0)d=-d;if(d>m)m=d} END{printf "%.3e", m+0}' "${SF}")
      OFF_HYPO_TABLE+=$(printf "  %-18s  V=%6.3f (SS=%5.2f, ratio=%s)  |σ_n_perturb|=%s Pa\n" "$tag" "$MV" "$SV" "$RAT" "$SP")
      OFF_HYPO_TABLE+=$'\n'
   fi
done

DISPATCH_LOG="${SBATCH_LOG_DIR}/tpv104_symmir_${SLURM_JOB_ID}.out"
DISPATCH_LINES=$(grep '\[dispatch\] rank=0' "${DISPATCH_LOG}" 2>/dev/null \
                 || echo "MISSING")
DISPATCH_OK=0
if echo "${DISPATCH_LINES}" | grep -q 'solver=brent' \
   && echo "${DISPATCH_LINES}" | grep -q 'iterator=oneshot' \
   && echo "${DISPATCH_LINES}" | grep -q 'fric-law=slip-srw'; then
   DISPATCH_OK=1
fi

# Verdict bands for the σ_n discriminator.
SIGMA_VERDICT="UNKNOWN"
if [ "${SIGMA_N_PERTURB_HYPO}" != "N/A" ]; then
   if awk "BEGIN { exit !(${SIGMA_N_PERTURB_HYPO} <= 1e3) }"; then
      SIGMA_VERDICT="PASS — σ_n flat to ≤ 1 kPa  (mesh non-mirror was the cause)"
   elif awk "BEGIN { exit !(${SIGMA_N_PERTURB_HYPO} <= 1e5) }"; then
      SIGMA_VERDICT="PARTIAL — σ_n perturbation reduced (1 kPa..0.1 MPa); residual leak from BC reflections or other source"
   else
      SIGMA_VERDICT="FAIL — σ_n still ≥ 0.1 MPa; mesh hypothesis falsified or other code path implicated"
   fi
fi

{
   echo "TPV104 Y-mirror-symmetric mesh discriminator run"
   echo "Mesh:                    tpv104_symmirror_200m (768k tets, 16x4x16 km, dx=200 m)"
   echo "tfinal:                  2.0 s"
   echo "f_w (compiled):          $(echo "${F_W_LINE}" | grep -oE '[01]\.[0-9]+' | head -1)"
   echo ""
   echo "peak |V_strike| at hypo  : ${PEAK_V_HYPO} m/s at t = ${PEAK_T_HYPO} s"
   echo "SeisSol reference (hypo) : 7.39 m/s at t = 1.07 s"
   echo "fwfix baseline (hypo)    : 7.42 m/s (~0.35% over SeisSol)"
   echo ""
   echo "peak |σ_n − 120 MPa| at hypo : ${SIGMA_N_PERTURB_HYPO} Pa"
   echo "fwfix baseline             : ~5e+05 Pa (0.5 MPa transient)"
   echo "SeisSol reference          : ~ULP (flat at 120 MPa)"
   echo "verdict                    : ${SIGMA_VERDICT}"
   echo ""
   echo "Per-station summary (V_strike + σ_n perturbation):"
   echo "${OFF_HYPO_TABLE}"
   echo "[dispatch] rank=0 lines  : ${DISPATCH_LINES}"
   if [ "${DISPATCH_OK}" -eq 1 ]; then
      echo "dispatch parity vs fwfix : PASS"
   else
      echo "dispatch parity vs fwfix : FAIL"
   fi
   echo ""
   if echo "${SIGMA_VERDICT}" | grep -q "^PASS" && [ "${DISPATCH_OK}" -eq 1 ] \
      && [ "${PEAK_V_HYPO}" != "N/A" ]; then
      echo "STATUS: PASS"
   else
      echo "STATUS: FAIL"
   fi
} > "${RESULT_FILE}"
cat "${RESULT_FILE}"
